    "runner_input": "executor 只接收 expand_scenario() 的 AgentScenario",
    "gold_access": "只有 evaluator 调用 expand_gold()",
    "oracle_policy": "禁止使用 Gold 构造 prediction",
    "frozen": true,
    "freeze_note": "正式报告生成后只允许通过升级 dataset version 修改"
  },
  "thresholds": {
    "task_success_rate_min": 1.0,
    "required_stage_coverage_min": 1.0,
