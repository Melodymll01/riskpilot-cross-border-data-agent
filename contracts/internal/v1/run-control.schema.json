{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "riskpilot/internal/v1/run-control",
  "title": "Agent runtime cancellation command",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "attempt_id", "reason"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "minLength": 1, "maxLength": 100},
    "attempt_id": {"type": "integer", "minimum": 1},
    "reason": {"type": "string", "minLength": 1, "maxLength": 200}
  }
}
