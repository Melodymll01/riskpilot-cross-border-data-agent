# ═══════════════════════════════════════════════════════
#  通道选择（两个可独立切换）
#  "api"   → 使用远端 API
#  "local" → 使用本机 Ollama
# ═══════════════════════════════════════════════════════
LLM_PROVIDER=api        # 对话 & 查询改写
EMBED_PROVIDER=api      # Embedding

# ═══════════════════════════════════════════════════════
#  远端 API 配置（LLM_PROVIDER=api 时生效）
# ═══════════════════════════════════════════════════════
OPENAI_API_KEY=your-api-key-here
OPENAI_API_BASE=https://open.bigmodel.cn/api/paas/v4
CHAT_MODEL=glm-4-flash
EMBEDDING_MODEL=embedding-3

# ═══════════════════════════════════════════════════════
#  本地 Ollama 配置（LLM_PROVIDER=local 时生效）
#  需先安装 Ollama: https://ollama.com
#  拉取模型: ollama pull qwen2.5:7b && ollama pull nomic-embed-text
# ═══════════════════════════════════════════════════════
OLLAMA_API_BASE=http://localhost:11434/v1
LOCAL_CHAT_MODEL=qwen2.5:7b
LOCAL_EMBEDDING_MODEL=nomic-embed-text

# ═══════════════════════════════════════════════════════
#  混合模式示例（embedding 用本地，对话用云端 API）
#  LLM_PROVIDER=api
#  EMBED_PROVIDER=local
# ═══════════════════════════════════════════════════════

# ── 其他参数 ──────────────────────────────────────────
CHAT_TEMPERATURE=0.2          # 范围 0.0-2.0，超出会报错
CHAT_MAX_TOKENS=1500
CHUNK_SIZE=600
CHUNK_OVERLAP=120
TOP_K=5
MAX_UPLOAD_MB=50              # 上传文件大小限制（MB）
OBJECT_STORE_DIR=./data/objects
TEXT_OVERLAP_THRESHOLD=0.7    # 文本去重重叠率阈值（0.0-1.0）
ENABLE_QUERY_REWRITE=true

# CORS（多个域名用逗号分隔）
# CORS_ORIGINS=["https://your-frontend.com","https://admin.your-app.com"]
# 默认 ["*"] 允许所有来源（开发用）

# ═══════════════════════════════════════════════════════
#  GitHub OAuth（Step 010 PR-6 引入；不配也能用，但匿名访客无法升级为 GitHub 用户）
#  注册 OAuth App: https://github.com/settings/developers → New OAuth App
#  Homepage URL          : http://127.0.0.1:8765
#  Authorization callback: http://127.0.0.1:8765/api/v2/auth/github/callback
# ═══════════════════════════════════════════════════════
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URI=http://127.0.0.1:8765/api/v2/auth/github/callback

# Session cookie 签名密钥（生产必须改！建议 32+ 随机字符）
JWT_SECRET=dev-jwt-secret-please-change-32-chars-minimum-length

# ═══════════════════════════════════════════════════════
#  管理员（Step 012-tail：权限基线）
#  user_id 命名空间需与 User.user_id 一致：
#    GitHub 用户  → github:<login>      （例 github:melody-rabbit）
#    匿名用户     → anon:<uuid>         （不推荐设为 admin）
#  支持两种写法：
#    逗号分隔：ADMIN_USER_IDS=github:foo,github:bar
#    JSON 数组：ADMIN_USER_IDS=["github:foo","github:bar"]
#  不填则系统无管理员，所有 /api/v2/documents/* 等管理接口对所有人 403。
# ═══════════════════════════════════════════════════════
ADMIN_USER_IDS=
# 示例: ADMIN_USER_IDS=github:melody-rabbit,github:another-admin

