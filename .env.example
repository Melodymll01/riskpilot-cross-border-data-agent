# ═══════════════════════════════════════════════════════
#  通道选择（两个可独立切换）
#  "api"   → 使用远端 API
#  "local" → 使用本机 Ollama
# ═══════════════════════════════════════════════════════
LLM_PROVIDER=api        # 对话 & 查询改写
EMBED_PROVIDER=api      # Embedding

# 本地 Profile：SQLite + Chroma；生产 Profile：PostgreSQL + pgvector。
STORAGE_BACKEND=sqlite
VECTOR_BACKEND=chroma
# DATABASE_URL=postgresql+psycopg://riskpilot:riskpilot@postgres:5432/riskpilot
# 生产示例：
# STORAGE_BACKEND=postgres
# VECTOR_BACKEND=pgvector
# DATABASE_URL=postgresql+psycopg://riskpilot:riskpilot@postgres:5432/riskpilot

# ═══════════════════════════════════════════════════════
#  远端 API 配置（LLM_PROVIDER=api 时生效）
# ═══════════════════════════════════════════════════════
OPENAI_API_KEY=your-api-key-here
OPENAI_API_BASE=https://open.bigmodel.cn/api/paas/v4
CHAT_MODEL=glm-4-flash
EMBEDDING_MODEL=embedding-3

# ═══════════════════════════════════════════════════════
#  本地 Ollama 配置（LLM_PROVIDER=local 时生效）
#  需先安装 Ollama: https://ollama.com
#  拉取模型: ollama pull qwen2.5:7b && ollama pull nomic-embed-text
# ═══════════════════════════════════════════════════════
OLLAMA_API_BASE=http://localhost:11434/v1
LOCAL_CHAT_MODEL=qwen2.5:7b
LOCAL_EMBEDDING_MODEL=nomic-embed-text

# ═══════════════════════════════════════════════════════
#  混合模式示例（embedding 用本地，对话用云端 API）
#  LLM_PROVIDER=api
#  EMBED_PROVIDER=local
# ═══════════════════════════════════════════════════════

# ── 其他参数 ──────────────────────────────────────────
CHAT_TEMPERATURE=0.2          # 范围 0.0-2.0，超出会报错
CHAT_MAX_TOKENS=1500
CHUNK_SIZE=600
CHUNK_OVERLAP=120
TOP_K=5
MAX_UPLOAD_MB=50              # 上传文件大小限制（MB）
OBJECT_STORE_DIR=./data/objects
# 本地默认文件系统；生产/Compose 使用 S3 协议连接 MinIO。
OBJECT_STORE_BACKEND=local
# OBJECT_STORE_BACKEND=s3
# S3_ENDPOINT_URL=http://minio:9000
# S3_ACCESS_KEY_ID=riskpilot
# S3_SECRET_ACCESS_KEY=replace-with-a-long-random-secret
# S3_BUCKET=riskpilot
# S3_REGION=us-east-1
LANGGRAPH_CHECKPOINT_DB_PATH=./data/langgraph-checkpoints.sqlite3
# Phase 4 启用 Celery 后配置；配置后 readiness 会要求 Redis PING 成功。
# REDIS_URL=redis://redis:6379/0
TEXT_OVERLAP_THRESHOLD=0.7    # 文本去重重叠率阈值（0.0-1.0）
ENABLE_QUERY_REWRITE=true

# 小规模图片召回（Chinese-CLIP 首次使用时懒加载）
VISUAL_MODEL_NAME=OFA-Sys/chinese-clip-vit-base-patch16
VISUAL_MAX_UPLOAD_MB=10

# 风险评估模型服务（schema-evidence-risk-profiling）
# RISK_PROFILE_API_BASE=http://127.0.0.1:9000
# RISK_PROFILE_API_KEY=
# RISK_PROFILE_TIMEOUT_SECONDS=30

# LangSmith AI Trace（默认关闭；启用后仍不上传 prompt、文档正文或模型回答）
RISK_PILOT_LANGSMITH_ENABLED=false
# LANGSMITH_API_KEY=
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_PROJECT=riskpilot
# LANGSMITH_SAMPLING_RATE=0.1
# LANGSMITH_HASH_SALT=replace-with-at-least-16-random-characters

# 长期记忆 hybrid_v1 召回（未配置时使用以下默认值）
MEMORY_RECALL_CANDIDATE_MULTIPLIER=4
MEMORY_RECALL_SEMANTIC_WEIGHT=0.65
MEMORY_RECALL_CONFIDENCE_WEIGHT=0.15
MEMORY_RECALL_SALIENCE_WEIGHT=0.15
MEMORY_RECALL_FRESHNESS_WEIGHT=0.05
MEMORY_RECALL_MIN_SEMANTIC_SCORE=0.25
MEMORY_RECALL_MIN_FINAL_SCORE=0.35
MEMORY_RECALL_FRESHNESS_HALF_LIFE_DAYS=90

# CORS（多个域名用逗号分隔）
# CORS_ORIGINS=["https://your-frontend.com","https://admin.your-app.com"]
# 默认 ["*"] 允许所有来源（开发用）

# ═══════════════════════════════════════════════════════
#  GitHub OAuth（Step 010 PR-6 引入；不配也能用，但匿名访客无法升级为 GitHub 用户）
#  注册 OAuth App: https://github.com/settings/developers → New OAuth App
#  Homepage URL          : http://127.0.0.1:8765
#  Authorization callback: http://127.0.0.1:8765/api/v2/auth/github/callback
# ═══════════════════════════════════════════════════════
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URI=http://127.0.0.1:8765/api/v2/auth/github/callback

# Session cookie 签名密钥（生产必须改！建议 32+ 随机字符）
JWT_SECRET=dev-jwt-secret-please-change-32-chars-minimum-length

# ═══════════════════════════════════════════════════════
#  管理员（Step 012-tail：权限基线）
#  user_id 命名空间需与 User.user_id 一致：
#    GitHub 用户  → github:<login>      （例 github:melody-rabbit）
#    匿名用户     → anon:<uuid>         （不推荐设为 admin）
#  支持两种写法：
#    逗号分隔：ADMIN_USER_IDS=github:foo,github:bar
#    JSON 数组：ADMIN_USER_IDS=["github:foo","github:bar"]
#  不填则系统无管理员，所有 /api/v2/documents/* 等管理接口对所有人 403。
# ═══════════════════════════════════════════════════════
ADMIN_USER_IDS=
# 示例: ADMIN_USER_IDS=github:melody-rabbit,github:another-admin

