# LLM_PROVIDER selects ALL language-model calls: Agent, query rewrite, summary,
# structured generation and verification. Values: api | local.
LLM_PROVIDER=api
EMBED_PROVIDER=sentence_transformer
LOCAL_SENTENCE_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# API Key mode uses CHAT_API_* when set, otherwise OPENAI_API_*.
OPENAI_API_KEY=your-api-key-here
OPENAI_API_BASE=https://open.bigmodel.cn/api/paas/v4
CHAT_MODEL=glm-4-flash
EMBEDDING_MODEL=embedding-3
EMBEDDING_DIMENSIONS=2048
# Optional separate chat endpoint (falls back to OPENAI_API_* when unset):
# CHAT_API_KEY=
# CHAT_API_BASE=
# EMBED_PROVIDER is independent of LLM_PROVIDER.
# EMBED_PROVIDER=api needs OPENAI_API_KEY.
# Or use an existing local OpenAI-compatible server:
# LLM_PROVIDER=local
# EMBED_PROVIDER=local
# OLLAMA_API_BASE=http://127.0.0.1:11434/v1
# LOCAL_CHAT_MODEL=qwen2.5:7b
# LOCAL_EMBEDDING_MODEL=nomic-embed-text

CONTROL_PLANE_DB_PATH=./data/control-plane.sqlite3
AGENT_RUNTIME_ARTIFACT_DB_PATH=./data/agent-runtime-artifacts.sqlite3
AGENT_RUNTIME_LANGGRAPH_CHECKPOINT_DB_PATH=./data/conversation-checkpoints.sqlite3
AGENT_RUNTIME_EMBED_CACHE_DIR=./data/embed_cache
RUN_MAX_DURATION_SECONDS=480
CONVERSATION_MODEL_CALL_TIMEOUT_SECONDS=100
CONVERSATION_TOOL_CALL_TIMEOUT_SECONDS=210
RUN_MAX_MODEL_CALLS=12
RUN_MAX_TOOL_CALLS=6
CONVERSATION_CONTROL_POLL_SECONDS=0.05
CHROMA_PERSIST_DIR=./data/chroma_db_bge_parent_child_v1
MAX_UPLOAD_MB=50
ENABLE_RERANKER=false
ENABLE_QUERY_REWRITE=false
CHUNK_SIZE=420
CHUNK_OVERLAP=84
EMBEDDING_MAX_INPUT_TOKENS=480
INDEX_SCHEMA_VERSION=parent-child-v1
EMBEDDING_INPUT_STRATEGY=section-path-prefix-v1
RETRIEVAL_VECTOR_CANDIDATE_MULTIPLIER=4
RETRIEVAL_BM25_CANDIDATE_MULTIPLIER=6
RETRIEVAL_CANDIDATE_MAX=100
SECTION_EXPANSION_MAX_CHARS=3600
RETRIEVAL_CONTEXT_TOTAL_MAX_CHARS=12000

JWT_SECRET=replace-with-random-secret-at-least-32-characters
# The dev-stack launcher creates a separate random service key with mode 0600.
INTERNAL_SERVICE_KEY_FILE=./data/internal-service.key
AGENT_RUNTIME_URL=http://127.0.0.1:8766
# Optional local launcher ports:
# CONTROL_PLANE_PORT=8765
# AGENT_RUNTIME_PORT=8766
CONTROL_PLANE_MAX_ACTIVE_REQUESTS=16
CONTROL_PLANE_RUNTIME_TIMEOUT_SECONDS=510
CONTROL_PLANE_RATE_PER_MINUTE=60
SSE_KEEPALIVE_SECONDS=15
# Optional project-only SDK override when local Apple CLT and the newest SDK differ:
# GO_SDKROOT=/Library/Developer/CommandLineTools/SDKs/MacOSX26.5.sdk
GITHUB_CLIENT_ID=dev-placeholder-client-id
GITHUB_CLIENT_SECRET=dev-placeholder-client-secret
GITHUB_REDIRECT_URI=http://127.0.0.1:8765/api/v2/auth/github/callback
ADMIN_USER_IDS=
COOKIE_SECURE=false
RATE_LIMIT_ENABLED=true
JSON_LOGS_ENABLED=true
PROMETHEUS_ENABLED=true
OBSERVABILITY_HASH_SALT=replace-with-random-observability-salt
# Optional tracing: docs/guides/langsmith-observability.md
RISK_PILOT_LANGSMITH_ENABLED=false
OTEL_ENABLED=false
